#!/bin/sh
# BLOCKS a merge commit that would bring in known malware markers.
# Portable: Windows (Git Bash), Linux, macOS.
HOOKDIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "$HOOKDIR/scanner.exe" ] && SCANNER="$HOOKDIR/scanner.exe" || SCANNER="$HOOKDIR/scanner"

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

"$SCANNER" -files $staged
if [ $? -ne 0 ]; then
    echo ""
    echo "BLOCKED: merge commit contains known malware markers. Clean the file(s) above before continuing."

    LOGDIR="$(dirname "$HOOKDIR")/logs"
    mkdir -p "$LOGDIR" 2>/dev/null
    printf '%s  GIT BLOCKED (merge): %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(pwd)" \
        >> "$LOGDIR/watch-log.txt" 2>/dev/null

    exit 1
fi

exit 0
