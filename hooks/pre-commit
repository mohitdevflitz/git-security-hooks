#!/bin/sh
# BLOCKS a commit that stages known malware markers.
# Portable: Windows (Git Bash), Linux, macOS.
HOOKDIR="$(cd "$(dirname "$0")" && pwd)"
[ -f "$HOOKDIR/scanner.exe" ] && SCANNER="$HOOKDIR/scanner.exe" || SCANNER="$HOOKDIR/scanner"

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# Skip this project's OWN repository.
#
# scanner.go and the hooks contain the malware signatures by design - that is
# the whole point of them. `scanner.exe -tree` already excludes the install
# folder, but `-files` does not, so committing changes to this project blocked
# itself. Detect "am I scanning my own repo?" by comparing the repo root with
# the install root (the parent of hooks/).
INSTALL_ROOT="$(cd "$HOOKDIR/.." && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$REPO_ROOT" ]; then
    a=$(printf '%s' "$INSTALL_ROOT" | tr 'A-Z' 'a-z')
    b=$(printf '%s' "$REPO_ROOT"    | tr 'A-Z' 'a-z')
    if [ "$a" = "$b" ]; then
        echo "git-security-hooks' own repo - skipping self-scan."
        exit 0
    fi
fi

"$SCANNER" -files $staged
if [ $? -ne 0 ]; then
    echo ""
    echo "BLOCKED: commit contains known malware markers. Clean the file(s) above before committing."

    # Also record it where the desktop alerter can see it. Hook output only
    # appears in the terminal, which is invisible when committing from an IDE.
    LOGDIR="$(dirname "$HOOKDIR")/logs"
    mkdir -p "$LOGDIR" 2>/dev/null
    printf '%s  GIT BLOCKED (commit): %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(pwd)" \
        >> "$LOGDIR/watch-log.txt" 2>/dev/null

    exit 1
fi

exit 0
